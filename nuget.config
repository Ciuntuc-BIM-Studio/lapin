<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    The core's packages (BubbleBim.*) come from bubble-core's feed on GitHub
    Packages, which needs a token while that repository is private: the
    environment variables BUBBLE_CORE_USER and BUBBLE_CORE_TOKEN (CI sets them
    from the workflow's token). A developer with bubble-core checked out beside
    this repo never needs them (engine/Directory.Build.props).
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="bubble-core" value="https://nuget.pkg.github.com/Ciuntuc-BIM-Studio/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="bubble-core">
      <package pattern="BubbleBim.*" />
    </packageSource>
  </packageSourceMapping>
  <packageSourceCredentials>
    <bubble-core>
      <add key="Username" value="%BUBBLE_CORE_USER%" />
      <add key="ClearTextPassword" value="%BUBBLE_CORE_TOKEN%" />
    </bubble-core>
  </packageSourceCredentials>
</configuration>
