# manifold for Linux is built by scripts/build-manifold.mjs (the Linux build makes it); macOS's and Windows' are committed (a Mac builds the Windows edition too).
engine/native/linux-x64/
# manifold for the engine in the browser: scripts/build-manifold.mjs --browser-wasm.
engine/native/browser-wasm/
# Intel Open Image Denoise (the path tracer's denoiser): fetched by scripts/fetch-oidn.mjs, never committed (≈ 51 MB a platform).
engine/native/*/oidn/
# The browser host's product, generated by scripts/build-web.mjs.
engine/src/Host/Lapin.Browser/generated/
build/
desktop/src-tauri/binaries/
desktop/src-tauri/resources/
desktop/src-tauri/tauri.product.json

