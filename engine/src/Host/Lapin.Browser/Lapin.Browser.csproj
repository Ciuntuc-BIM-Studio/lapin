<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <!--
    The engine in the browser (docs/plan-browser-engine.md): the same engine
    as the desktop's, run in a Web Worker. Not in Lapin.slnx: the desktop build
    and its CI never see it; scripts/build-web.mjs builds it for one product
    (it writes generated/, the product's modules) with the .NET wasm-tools
    workload. AOT, trimmed whole: the engine's JSON is generated at build time.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RunAOTCompilation Condition="'$(Configuration)' == 'Release'">true</RunAOTCompilation>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <!-- manifold is linked in: the static libraries come with BubbleBim.Booleans (its build targets), or from the core beside the repo (engine/Directory.Build.targets). -->
    <WasmBuildNative>true</WasmBuildNative>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Platform/Lapin.Protocol/Lapin.Protocol.csproj" />
    <!-- Referenced here, not only through the platform: a package's build targets do not flow through a project reference. -->
    <BubbleCore Include="BubbleBim.Booleans" />
  </ItemGroup>
  <Import Project="generated/Product.g.props" />
</Project>
