<Project>
  <!-- Common to every Lapin engine project. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Where every module lands after a build, ready for the host to load and a product build to ship. -->
    <LapinModulesDir>$(MSBuildThisFileDirectory)artifacts/modules/</LapinModulesDir>
    <!--
      The core shared with BubbleBIM Pro (github.com/Ciuntuc-BIM-Studio/bubble-core):
      BubbleBim.Geometry, BubbleBim.Booleans, BubbleBim.Step. From its packages
      (BubbleCoreVersion, from nuget.org), or from that repository
      itself when it is checked out beside this one (../bubble-core, or
      BUBBLE_CORE_DIR), so the core and Lapin can be worked on together. CI
      never has it beside: CI always builds against the published packages.
      BubbleCoreFromPackages=true forces the packages here too.
    -->
    <BubbleCoreVersion>0.2.0</BubbleCoreVersion>
    <BubbleCoreDir Condition="'$(BubbleCoreFromPackages)' != 'true' And '$(BUBBLE_CORE_DIR)' != ''">$([MSBuild]::EnsureTrailingSlash('$(BUBBLE_CORE_DIR)'))</BubbleCoreDir>
    <BubbleCoreDir Condition="'$(BubbleCoreFromPackages)' != 'true' And '$(BubbleCoreDir)' == '' And Exists('$(MSBuildThisFileDirectory)../../bubble-core/BubbleCore.slnx')">$(MSBuildThisFileDirectory)../../bubble-core/</BubbleCoreDir>
  </PropertyGroup>
</Project>
