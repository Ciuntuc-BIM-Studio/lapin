{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The Lapin window: core APIs, open/save dialogs, closing with a save prompt, and the engine address.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-ask",
    "dialog:allow-message"
  ]
}
