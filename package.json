{
  "name": "lapin-pro",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "setup": "git submodule update --init && pnpm install && pnpm build:engine",
    "build:engine": "dotnet build vendor/bubblebim-pro/engine/BubbleBim.slnx -v q -nologo",
    "dev": "node scripts/dev.mjs",
    "typecheck": "pnpm --filter ui typecheck",
    "test": "pnpm --filter ui test",
    "dev:desktop": "node scripts/dev.mjs --desktop",
    "tauri": "tauri"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0"
  }
}
