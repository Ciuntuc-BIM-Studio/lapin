{
  "name": "lapin-pro",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "setup": "git submodule update --init && pnpm install && pnpm build:engine",
    "build:engine": "dotnet build engine/Lapin.slnx -v q -nologo",
    "dev": "node scripts/dev.mjs",
    "dev:desktop": "node scripts/dev.mjs --desktop",
    "typecheck": "pnpm --filter ui typecheck",
    "test": "pnpm --filter ui test && pnpm test:engine",
    "test:engine": "dotnet test engine/tests/Lapin.Engine.Tests -v q -nologo",
    "products": "node scripts/product.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "build": "node scripts/check-licenses.mjs && pnpm --filter ui build",
    "build:product": "node scripts/check-licenses.mjs && node scripts/build-product.mjs",
    "tauri": "tauri"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0"
  }
}
